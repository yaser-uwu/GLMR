        <mxCell id="e-renew-rpc" edge="1" parent="1" source="web" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#24559D;dashed=0;exitX=0.48951;exitY=0.00000;exitPerimeter=0;entryX=0.16776;entryY=0.00000;entryPerimeter=0;html=1;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#152F53;labelBackgroundColor=#FFFFFF;labelBorderColor=#B3C8E5;align=center;verticalAlign=middle;spacing=4;" target="bill" value="&lt;div style=&quot;text-align:center&quot;&gt;RenovarSuscripcion con usuario, plan y token → estado&lt;br&gt;RPC síncrona · HTTP/2 + TLS · gRPC Java&lt;div style=&quot;font-size:14px;line-height:16px;font-style:italic;margin-top:3px&quot;&gt;Un contrato tipado conserva el identificador de operación y el estado.&lt;/div&gt;&lt;/div&gt;">
