        <mxCell id="e-lic" edge="1" parent="1" source="web" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#24559D;dashed=0;exitX=1.00000;exitY=0.17037;exitPerimeter=0;entryX=0.00000;entryY=0.34146;entryPerimeter=0;html=1;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#152F53;labelBackgroundColor=#FFFFFF;labelBorderColor=#B3C8E5;align=center;verticalAlign=middle;spacing=4;" target="lic" value="&lt;div style=&quot;text-align:center&quot;&gt;IniciarSesion o&lt;br&gt;EmitirLicencia → sesión,&lt;br&gt;licencia o rechazo&lt;br&gt;RPC síncrona · HTTP/2 +&lt;br&gt;TLS · gRPC Java&lt;div style=&quot;font-size:14px;line-height:16px;font-style:italic;margin-top:3px&quot;&gt;Respuesta inmediata para&lt;br&gt;arrancar en menos de 2 s.&lt;/div&gt;&lt;/div&gt;">
