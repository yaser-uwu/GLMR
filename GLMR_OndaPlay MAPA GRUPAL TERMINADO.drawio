        <mxCell id="e-poll" edge="1" parent="1" source="kafka" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#24559D;dashed=1;exitX=1.00000;exitY=0.50000;exitPerimeter=0;entryX=0.00000;entryY=0.50000;entryPerimeter=0;fontColor=#152F53;fontSize=18;fontStyle=0;labelBackgroundColor=#FFFFFF;html=1;fontFamily=Arial;labelBorderColor=#B3C8E5;align=center;verticalAlign=middle;spacing=4;" target="worker" value="&lt;div style=&quot;text-align:center&quot;&gt;Eventos por poll&lt;br&gt;Confirma posición&lt;br&gt;tras guardar&lt;br&gt;Asíncrona · TCP/TLS&lt;br&gt;librdkafka&lt;div style=&quot;font-size:14px;line-height:16px;font-style:italic;margin-top:3px&quot;&gt;La retención permite&lt;br&gt;recuperar tras 2 h de&lt;br&gt;caída.&lt;/div&gt;&lt;/div&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
