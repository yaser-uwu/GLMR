        <mxCell id="e-payment" edge="1" parent="1" source="bill" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#24559D;dashed=0;exitX=0.50000;exitY=1.00000;exitPerimeter=0;entryX=0.50000;entryY=0.00000;entryPerimeter=0;html=1;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#152F53;labelBackgroundColor=#FFFFFF;labelBorderColor=#B3C8E5;align=center;verticalAlign=middle;spacing=4;" target="pay" value="&lt;div style=&quot;text-align:center&quot;&gt;Monto, token y clave → pago&lt;br&gt;aprobado, rechazado o&lt;br&gt;pendiente&lt;br&gt;REST síncrona · HTTPS/JSON&lt;div style=&quot;font-size:14px;line-height:16px;font-style:italic;margin-top:3px&quot;&gt;La clave idempotente evita cobros&lt;br&gt;duplicados al reintentar.&lt;/div&gt;&lt;/div&gt;">
