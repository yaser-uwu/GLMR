        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="rep" style="startArrow=open;startFill=0;endArrow=block;html=0;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="web" value="E1&#xa;Renovar suscripción">
