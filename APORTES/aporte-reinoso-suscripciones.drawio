        <mxCell id="e5" edge="1" parent="1" source="kaf" style="endArrow=block;html=0;rounded=0;strokeWidth=2;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="lic" value="E5&#xa;Leer el aviso">
          <mxGeometry relative="1" x="-0.0041" y="30" as="geometry">
