          <mxGeometry height="90" width="170" x="1000" y="195" as="geometry" />
        </mxCell>
        <mxCell id="lic" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" value="Autenticación y licencias" vertex="1">
