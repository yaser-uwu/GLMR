        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="web" style="startArrow=open;startFill=0;endArrow=block;html=0;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="fac" value="E2&#xa;RenovarSuscripcion">
          <mxGeometry relative="1" x="0.0588" y="20" as="geometry">
