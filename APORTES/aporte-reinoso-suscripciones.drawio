        <mxCell id="e4" edge="1" parent="1" source="fac" style="endArrow=block;html=0;rounded=0;strokeWidth=2;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="kaf" value="E4&#xa;Aviso: suscripción&#xa;actualizada">
