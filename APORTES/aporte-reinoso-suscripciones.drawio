        <mxCell id="e3" edge="1" parent="1" source="fac" style="startArrow=open;startFill=0;endArrow=block;html=0;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" target="pas" value="E3&#xa;Cobrar">
